{
  "name": "web3-backend-engineering-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio project demonstrating Ethereum contract reads, authenticated Sepolia writes, and deterministic REST API design.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "security:scan": "node scripts/security-scan.mjs",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "contract:deploy": "tsx scripts/deploy-contract.ts",
    "contract:verify": "npm run contract:compile && tsx scripts/verify-deployment.ts",
    "demo": "tsx scripts/demo.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run security:scan"
  },
  "dependencies": {
    "express": "5.2.1",
    "viem": "2.55.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "solc": "0.8.30",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
